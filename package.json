{
  "name": "@nuria-tech/auth-sdk",
  "version": "9.2.1",
  "description": "Browser OAuth 2.1 (Authorization Code + PKCE) client SDK. Google login uses Google Identity Services (FedCM); federated OIDC IdPs use code+PKCE bridge exchange; magic-link (passwordless), password, 2FA, and passkey (WebAuthn) login; optional DPoP sender-constrained tokens and step-up auth; self-service account management.",
  "license": "MIT",
  "author": "Nuria Tech",
  "keywords": [
    "auth",
    "oauth2",
    "pkce",
    "oidc",
    "authentication",
    "sdk",
    "webauthn",
    "passkey",
    "dpop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuria-tech/nuria-auth-sdk.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "require": "./dist/nuxt.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js",
      "require": "./dist/angular.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup",
    "test": "vitest run",
    "test:build": "vitest run tests/build-artifacts.spec.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@angular/common": ">=16.0.0",
    "@angular/core": ">=16.0.0",
    "next": ">=13.0.0",
    "nuxt": ">=3.0.0",
    "react": ">=18",
    "rxjs": ">=7.8",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "happy-dom": "^20.10.2",
    "prettier": "3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rxjs": "7.8.2",
    "tsup": "8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vue": "^3.5.35"
  }
}
